{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TokenSonar 主窗口所需的最小权限集合",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "updater:default",
    "process:allow-restart",
    "allow-list-providers",
    "allow-save-provider",
    "allow-remove-provider",
    "allow-reorder-providers",
    "allow-test-provider",
    "allow-refresh-provider",
    "allow-refresh-all",
    "allow-get-snapshots",
    "allow-list-ledger",
    "allow-add-ledger-entry",
    "allow-remove-ledger-entry",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-app-info",
    "allow-open-data-dir",
    "allow-open-external-url",
    "allow-get-sync-config",
    "allow-save-sync-config",
    "allow-test-sync-connection",
    "allow-pull-remote-backup",
    "allow-sync-to-repo",
    "allow-start-deepseek-login",
    "allow-start-mimo-login"
  ]
}
